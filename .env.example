# Conexión a MongoDB Atlas (Database → Connect → Drivers). Incluye usuario y contraseña.
MONGODB_URI="mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Nombre de la base de datos (opcional)
MONGODB_DB="brawl_tournaments"

# Secreto para firmar las sesiones del staff (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Zona horaria del torneo (para mostrar y cargar horarios)
NEXT_PUBLIC_TIMEZONE="America/La_Paz"
TOURNAMENT_UTC_OFFSET="-04:00"

# Solo si usas un mongod local SIN replica set (Atlas no lo necesita):
# MONGODB_TRANSACTIONS=false
